{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CODEX_PROJECT_DIR:-.}/.agent-hooks/block-non-pnpm.sh\"",
            "statusMessage": "pnpm 縛りチェック"
          },
          {
            "type": "command",
            "command": "bash \"${CODEX_PROJECT_DIR:-.}/.agent-hooks/block-new-dependency.sh\"",
            "statusMessage": "新規ライブラリ追加チェック"
          },
          {
            "type": "command",
            "command": "bash \"${CODEX_PROJECT_DIR:-.}/.agent-hooks/block-force-push.sh\"",
            "statusMessage": "強制プッシュチェック"
          },
          {
            "type": "command",
            "command": "bash \"${CODEX_PROJECT_DIR:-.}/.agent-hooks/block-main-branch-changes.sh\"",
            "statusMessage": "main ブランチ直接変更チェック"
          },
          {
            "type": "command",
            "command": "bash \"${CODEX_PROJECT_DIR:-.}/.agent-hooks/pre-push-typecheck.sh\"",
            "statusMessage": "push 前の型チェック"
          },
          {
            "type": "command",
            "command": "bash \"${CODEX_PROJECT_DIR:-.}/.agent-hooks/pre-push-lint.sh\"",
            "statusMessage": "push 前の全体 lint チェック"
          },
          {
            "type": "command",
            "command": "bash \"${CODEX_PROJECT_DIR:-.}/.agent-hooks/pre-push-test-rules.sh\"",
            "statusMessage": "push 前のテストルール検査"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CODEX_PROJECT_DIR:-.}/.agent-hooks/block-lint-suppress.sh\"",
            "statusMessage": "lint 抑制コメントチェック"
          },
          {
            "type": "command",
            "command": "bash \"${CODEX_PROJECT_DIR:-.}/.agent-hooks/block-new-dependency.sh\"",
            "statusMessage": "新規ライブラリ追加チェック"
          },
          {
            "type": "command",
            "command": "bash \"${CODEX_PROJECT_DIR:-.}/.agent-hooks/block-main-branch-changes.sh\"",
            "statusMessage": "main ブランチ直接変更チェック"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CODEX_PROJECT_DIR:-.}/.agent-hooks/post-edit-lint.sh\"",
            "statusMessage": "編集後の自動リントチェック"
          },
          {
            "type": "command",
            "command": "bash \"${CODEX_PROJECT_DIR:-.}/.agent-hooks/check-test-rules.sh\"",
            "statusMessage": "テストルール検証"
          }
        ]
      }
    ]
  }
}
